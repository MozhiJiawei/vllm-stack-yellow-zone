diff --git a/vllm/v1/executor/multiproc_executor.py b/vllm/v1/executor/multiproc_executor.py
index bd0cf37..9ee9bf9 100644
--- a/vllm/v1/executor/multiproc_executor.py
+++ b/vllm/v1/executor/multiproc_executor.py
@@ -73,12 +73,12 @@ def _install_pair_worker_gate(
 
     parallel_config = vllm_config.parallel_config
     if parallel_config.pipeline_parallel_size != 1:
-        raise ValueError("vLLM pair scheduling v3 does not support Pipeline Parallel")
+        raise ValueError("vLLM pair scheduling v4 does not support Pipeline Parallel")
     if parallel_config.nnodes_within_dp != 1:
-        raise ValueError("vLLM pair scheduling v3 requires single-node workers")
+        raise ValueError("vLLM pair scheduling v4 requires single-node workers")
     worker_count = parallel_config.local_world_size
     if worker_count > 64:
-        raise ValueError("vLLM pair scheduling v3 supports at most 64 local workers")
+        raise ValueError("vLLM pair scheduling v4 supports at most 64 local workers")
 
     from vllm_pair_scheduler import create_worker_forward_gate_from_install
 
@@ -87,20 +87,47 @@ def _install_pair_worker_gate(
         worker_count=worker_count,
     )
     execute_model = worker.execute_model
+    sample_tokens = worker.sample_tokens
+    active_round = None
 
     def gated_execute_model(scheduler_output):
+        nonlocal active_round
         if scheduler_output.total_num_scheduled_tokens <= 0:
             return execute_model(scheduler_output)
-        forward_round = gate.enter_forward()
+        if active_round is not None:
+            gate.fail(203)
+            raise RuntimeError(
+                "pair scheduler received execute_model before sampling completed"
+            )
+        active_round = gate.enter_forward()
         try:
             output = execute_model(scheduler_output)
-            gate.leave_forward(*forward_round)
+            if output is not None:
+                gate.leave_forward(*active_round)
+                active_round = None
             return output
         except Exception:
+            active_round = None
             gate.fail(201)
             raise
 
+    def gated_sample_tokens(grammar_output):
+        nonlocal active_round
+        if active_round is None:
+            active_round = gate.enter_forward()
+        sampling_round = active_round
+        try:
+            output = sample_tokens(grammar_output)
+            gate.leave_forward(*sampling_round)
+            active_round = None
+            return output
+        except Exception:
+            active_round = None
+            gate.fail(202)
+            raise
+
     worker.execute_model = gated_execute_model
+    worker.sample_tokens = gated_sample_tokens
     return gate
 
 
